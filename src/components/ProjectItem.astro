---
interface Props {
  name: string;
  description: string;
  href: string;
}

const { name, description, href } = Astro.props;
---

<li class="not-prose">
  <a href={href} target="_blank" rel="noopener noreferrer" class="group">
    <span
      class="bg-accent-soft text-article px-2 py-1 rounded-xs font-normal hover:bg-accent hover:text-bg"
      >{name}</span
    >
    <span class="text-article">{description}</span>
  </a>
</li>
