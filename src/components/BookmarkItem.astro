---
interface Props {
  title: string;
  date: Date | string;
  url: string;
}

const { title, date, url } = Astro.props;

import FormattedDate from "./FormattedDate.astro";
---

<li class="grid md:grid-cols-[1fr_auto] gap-x-3 gap-y-2 w-full max-w-3xl">
  <a href={url} class="min-w-0 hover:text-accent" target="_blank">
    <div class="group grid gap-1 items-start justify-between">
      <span class="text-article group-hover:text-accent max-w-lg"
        >{title}</span
      >

      <span class="text-sm text-article font-normal"
        >{url.replace("https://", "")}</span
      >
    </div>
  </a>

  <FormattedDate
    date={date}
    className="min-w-fit text-article text-xs font-mono lowercase md:text-right whitespace-nowrap"
  />
</li>
